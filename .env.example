# Copy this file to .env and replace every "changethis" value.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets to this repository.

# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
# Defaults target the local mailcatcher service from compose.override.yml.
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
